# Chave privada da Groq. NUNCA coloque isto no frontend.
GROQ_API_KEY=sua_chave_groq_aqui

# Modelo usado pelo backend.
GROQ_MODEL=llama-3.3-70b-versatile

# Em produção, substitua pelo domínio real do Netlify.
# Separe múltiplas origens por vírgula.
FRONTEND_ORIGINS=http://localhost:5500

MAX_HISTORY=16
MAX_MESSAGE_CHARS=4000
PORT=5000
